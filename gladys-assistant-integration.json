{
  "manifest_version": 1,
  "type": "device",
  "name": "LIFX",
  "description": {
    "en": "LIFX bulbs, strips and matrices on the local network: colors, whites, effects, pulse.",
    "fr": "Ampoules, rubans et matrices LIFX en réseau local : couleurs, blancs, effets, clignotement.",
    "de": "LIFX-Lampen, -Streifen und -Matrizen im lokalen Netzwerk: Farben, Weißtöne, Effekte, Blinken.",
    "es": "Bombillas, tiras y matrices LIFX en la red local: colores, blancos, efectos, parpadeo."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-lifx:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-lifx/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "udp-active-broadcast",
      "ports": [56700]
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Finding your LIFX lights",
        "fr": "Trouver vos lampes LIFX",
        "de": "Deine LIFX-Lampen finden",
        "es": "Encontrar sus luces LIFX"
      },
      "description": {
        "en": "LIFX lights on the same network as Gladys are found automatically: open the Discovery tab. Set them up in the LIFX app first. If one is missing, enter its IP address below.",
        "fr": "Les lampes LIFX du même réseau que Gladys sont trouvées automatiquement : ouvrez l'onglet Découverte. Configurez-les d'abord dans l'application LIFX. S'il en manque une, saisissez son adresse IP ci-dessous.",
        "de": "LIFX-Lampen im selben Netzwerk wie Gladys werden automatisch gefunden: Öffne den Tab „Entdecken“. Richte sie zuerst in der LIFX-App ein. Fehlt eine, gib unten ihre IP-Adresse ein.",
        "es": "Las luces LIFX de la misma red que Gladys se encuentran automáticamente: abra la pestaña Descubrir. Configúrelas primero en la aplicación LIFX. Si falta alguna, introduzca su dirección IP a continuación."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-lifx/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "IP addresses of LIFX lights",
        "fr": "Adresses IP des lampes LIFX",
        "de": "IP-Adressen der LIFX-Lampen",
        "es": "Direcciones IP de las luces LIFX"
      },
      "description": {
        "en": "Optional, separated by commas. Only needed for the lights automatic discovery does not find.",
        "fr": "Facultatif, séparées par des virgules. Seulement pour les lampes que la découverte automatique ne trouve pas.",
        "de": "Optional, durch Kommas getrennt. Nur für Lampen nötig, die die automatische Erkennung nicht findet.",
        "es": "Opcional, separadas por comas. Solo para las luces que el descubrimiento automático no encuentra."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50, 192.168.1.51",
        "fr": "ex. 192.168.1.50, 192.168.1.51",
        "de": "z. B. 192.168.1.50, 192.168.1.51",
        "es": "p. ej. 192.168.1.50, 192.168.1.51"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle d'actualisation",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often each light is read, to follow the changes made from the LIFX app, a voice assistant or a wall switch.",
        "fr": "Fréquence de lecture de chaque lampe, pour suivre les changements faits depuis l'application LIFX, un assistant vocal ou un interrupteur mural.",
        "de": "Wie oft jede Lampe gelesen wird, um Änderungen aus der LIFX-App, über einen Sprachassistenten oder einen Wandschalter zu verfolgen.",
        "es": "Frecuencia de lectura de cada luz, para seguir los cambios hechos desde la aplicación LIFX, un asistente de voz o un interruptor de pared."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 seconds",
            "fr": "60 secondes",
            "de": "60 Sekunden",
            "es": "60 segundos"
          }
        }
      ]
    },
    {
      "key": "transition",
      "type": "select",
      "label": {
        "en": "Transition",
        "fr": "Transition",
        "de": "Übergang",
        "es": "Transición"
      },
      "description": {
        "en": "Fade of the changes made from Gladys: on, off, brightness, color and white.",
        "fr": "Fondu des changements faits depuis Gladys : allumage, extinction, luminosité, couleur et blanc.",
        "de": "Überblendung der Änderungen aus Gladys: Ein, Aus, Helligkeit, Farbe und Weißton.",
        "es": "Fundido de los cambios hechos desde Gladys: encendido, apagado, brillo, color y blanco."
      },
      "required": false,
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "None (instant)",
            "fr": "Aucune (immédiat)",
            "de": "Keiner (sofort)",
            "es": "Ninguna (inmediato)"
          }
        },
        {
          "value": "250",
          "label": {
            "en": "0.25 seconds",
            "fr": "0,25 seconde",
            "de": "0,25 Sekunden",
            "es": "0,25 segundos"
          }
        },
        {
          "value": "500",
          "label": {
            "en": "0.5 seconds",
            "fr": "0,5 seconde",
            "de": "0,5 Sekunden",
            "es": "0,5 segundos"
          }
        },
        {
          "value": "1000",
          "label": {
            "en": "1 second",
            "fr": "1 seconde",
            "de": "1 Sekunde",
            "es": "1 segundo"
          }
        },
        {
          "value": "2000",
          "label": {
            "en": "2 seconds",
            "fr": "2 secondes",
            "de": "2 Sekunden",
            "es": "2 segundos"
          }
        },
        {
          "value": "5000",
          "label": {
            "en": "5 seconds",
            "fr": "5 secondes",
            "de": "5 Sekunden",
            "es": "5 segundos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms des fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de las funciones"
      },
      "description": {
        "en": "Names given to the features of new lights (Light, Brightness, LIFX effect...). The light names come from the LIFX app.",
        "fr": "Noms donnés aux fonctionnalités des nouvelles lampes (Éclairage, Luminosité, Effet LIFX…). Les noms des lampes viennent de l'application LIFX.",
        "de": "Namen, die den Funktionen neuer Lampen gegeben werden (Licht, Helligkeit, LIFX-Effekt…). Die Lampennamen kommen aus der LIFX-App.",
        "es": "Nombres dados a las funciones de las nuevas luces (Luz, Brillo, Efecto LIFX…). Los nombres de las luces vienen de la aplicación LIFX."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search",
      "label": {
        "en": "Search for LIFX lights",
        "fr": "Rechercher les lampes LIFX",
        "de": "LIFX-Lampen suchen",
        "es": "Buscar luces LIFX"
      },
      "description": {
        "en": "Looks for LIFX lights again and reports the ones found.",
        "fr": "Recherche à nouveau les lampes LIFX et liste celles trouvées.",
        "de": "Sucht erneut nach LIFX-Lampen und listet die gefundenen auf.",
        "es": "Busca de nuevo las luces LIFX e indica las encontradas."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_actions": [
    {
      "key": "pulse",
      "label": {
        "en": "Pulse a LIFX light",
        "fr": "Faire clignoter une lampe LIFX",
        "de": "LIFX-Lampe blinken lassen",
        "es": "Hacer parpadear una luz LIFX"
      },
      "description": {
        "en": "Blinks or breathes in a color a number of times, then the light goes back to what it showed, off included. Made for alerts.",
        "fr": "Clignote ou pulse dans une couleur un certain nombre de fois, puis la lampe revient à ce qu'elle affichait, éteinte comprise. Fait pour les alertes.",
        "de": "Blinkt oder pulsiert einige Male in einer Farbe, danach zeigt die Lampe wieder ihren vorherigen Zustand, auch ausgeschaltet. Gedacht für Alarme.",
        "es": "Parpadea o respira en un color varias veces y luego la luz vuelve a lo que mostraba, apagada incluida. Pensado para alertas."
      },
      "timeout_seconds": 20,
